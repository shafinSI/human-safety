generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  contacts EmergencyContact[]
  guardians Guardian[]
  alerts    EmergencyAlert[]
  travels   SafetyTravel[]
}

model EmergencyContact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  relation  String
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Guardian {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model EmergencyAlert {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  location  String?
  status    String   @default("active")
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SafetyTravel {
  id            Int      @id @default(autoincrement())
  startLocation String
  endLocation   String
  travelMode    String
  status        String   @default("active")
  userId        Int
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model GuardianAlert {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  latitude  Float
  longitude Float
  mapLink   String
  createdAt DateTime @default(now())
}

model SafetyRouteCheck {
  id          Int      @id @default(autoincrement())
  startPoint  String
  destination String
  score       Int
  riskLevel   String
  mapLink     String
  createdAt   DateTime @default(now())
}

model NearbyAlert {
  id        Int      @id @default(autoincrement())
  latitude  Float
  longitude Float
  message   String
  createdAt DateTime @default(now())
}